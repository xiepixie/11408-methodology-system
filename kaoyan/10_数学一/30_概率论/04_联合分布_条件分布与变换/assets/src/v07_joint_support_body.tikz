\pgfdeclarelayer{background}
\pgfdeclarelayer{foreground}
\pgfsetlayers{background,main,foreground}

\begin{tikzpicture}[color=themefg, text=themefg]

% ==================== Left Side: 2D Joint Support Geometry ====================
\begin{scope}[x=1.30cm,y=1.30cm]
  \begin{pgfonlayer}{background}
    % 坐标轴
    \draw[themefg, line width=0.9pt, -{Stealth[length=2.2mm]}]
      (-0.15,0) -- (4.65,0) node[below left=1pt] {$x$};
    \draw[themefg, line width=0.9pt, -{Stealth[length=2.2mm]}]
      (0,-0.15) -- (0,4.30) node[below left=1pt] {$y$};

    % 二维联合支撑集 D 填充与边界
    \filldraw[
      fill=themecurve,
      fill opacity=0.14,
      draw=themecurve,
      line width=1.8pt
    ] (0.80, 1.40)
      .. controls (0.95, 0.55) and (1.80, 0.45) .. (2.95, 0.70)
      .. controls (4.00, 0.95) and (4.50, 1.65) .. (4.30, 2.50)
      .. controls (4.05, 3.55) and (2.85, 3.90) .. (1.70, 3.55)
      .. controls (0.95, 3.10) and (0.65, 2.15) .. cycle;

    % 等值截线 g(x,y)=z
    \draw[themecurve, densely dashed, line width=1.3pt] (0.50, 3.45) -- (3.75, 0.20);

    % 竖截面 X = x_0 引线与主切片线
    \draw[themegray, densely dotted, line width=0.9pt] (2.15, 0) -- (2.15, 0.55);
    \draw[themeamber, line width=2.4pt] (2.15, 0.55) -- (2.15, 3.75);

    % 横截面 Y = y_0 引线与主切片线
    \draw[themegray, densely dotted, line width=0.9pt] (0, 1.60) -- (0.70, 1.60);
    \draw[themealert, line width=2.2pt] (0.70, 1.60) -- (4.35, 1.60);
  \end{pgfonlayer}

  \begin{pgfonlayer}{foreground}
    % 竖截面端点与标注
    \filldraw[fill=themeamber, draw=themebg, line width=0.8pt] (2.15, 0.55) circle (2.2pt);
    \filldraw[fill=themeamber, draw=themebg, line width=0.8pt] (2.15, 3.75) circle (2.2pt);
    \node[text=themefg, fill=themebg, inner sep=0.8pt, anchor=north] at (2.15, -0.08) {\footnotesize $x_0$};
    \node[text=themeamber, fill=themebg, inner sep=0.8pt, anchor=north] at (2.15, 0.44) {\scriptsize $y_1(x_0)$};
    \node[text=themeamber, fill=themebg, inner sep=0.8pt, anchor=south] at (2.15, 3.86) {\scriptsize $y_2(x_0)$};

    % 横截面端点与标注
    \filldraw[fill=themealert, draw=themebg, line width=0.8pt] (0.70, 1.60) circle (2.2pt);
    \filldraw[fill=themealert, draw=themebg, line width=0.8pt] (4.35, 1.60) circle (2.2pt);
    \node[text=themefg, fill=themebg, inner sep=0.8pt, anchor=east] at (-0.08, 1.60) {\footnotesize $y_0$};
    \node[text=themealert, fill=themebg, inner sep=0.8pt, anchor=north] at (0.70, 1.30) {\scriptsize $x_1(y_0)$};
    \node[text=themealert, fill=themebg, inner sep=0.8pt, anchor=north] at (4.35, 1.30) {\scriptsize $x_2(y_0)$};

    % 支撑集标志 D（置于右上开阔区）
    \node[text=themecurve, fill=themebg, inner sep=1.0pt, font=\bfseries] at (3.25, 2.85) {支撑集 $D$};

    % 等值截线标注（置于支撑左上方）
    \node[text=themecurve, fill=themebg, inner sep=0.8pt, anchor=south west] at (0.50, 3.45)
      {\footnotesize 等值截线 $g(x,y)=z$};
  \end{pgfonlayer}
\end{scope}

% ==================== Right Side: Spacious Annotation Panels ====================
\begin{scope}[xshift=6.6cm]
  \begin{pgfonlayer}{foreground}
    % 竖截面机制卡片
    \node[
      anchor=north west,
      draw=themeamber!70!themegray,
      rounded corners=2.0mm,
      fill=themebg,
      inner xsep=8pt,
      inner ysep=6pt,
      text width=7.2cm
    ] (card1) at (0, 5.6) {
      {\color{themeamber}\bfseries\small $\blacksquare$ 边缘分布与条件分布（竖截面 $X=x_0$）}\\[3pt]
      {\footnotesize $\bullet$ 积分区间：$y \in [y_1(x_0),\, y_2(x_0)]$}\\[2pt]
      {\footnotesize $\bullet$ 边缘密度：$\displaystyle f_X(x_0) = \int_{y_1(x_0)}^{y_2(x_0)} f(x_0,y)\,\mathrm{d}y$}\\[3pt]
      {\footnotesize $\bullet$ 条件密度：$\displaystyle f_{Y\mid X}(y\mid x_0) = \frac{f(x_0,y)}{f_X(x_0)}$\quad（截面归一化）}
    };

    % 横截面机制卡片
    \node[
      anchor=north west,
      draw=themealert!70!themegray,
      rounded corners=2.0mm,
      fill=themebg,
      inner xsep=8pt,
      inner ysep=6pt,
      text width=7.2cm
    ] (card2) at (0, 2.5) {
      {\color{themealert}\bfseries\small $\blacksquare$ 边缘分布与条件分布（横截面 $Y=y_0$）}\\[3pt]
      {\footnotesize $\bullet$ 积分区间：$x \in [x_1(y_0),\, x_2(y_0)]$}\\[2pt]
      {\footnotesize $\bullet$ 边缘密度：$\displaystyle f_Y(y_0) = \int_{x_1(y_0)}^{x_2(y_0)} f(x,y_0)\,\mathrm{d}x$}\\[3pt]
      {\footnotesize $\bullet$ 条件密度：$\displaystyle f_{X\mid Y}(x\mid y_0) = \frac{f(x,y_0)}{f_Y(y_0)}$\quad（截面归一化）}
    };
  \end{pgfonlayer}
\end{scope}

% ==================== Bottom Global Takeaway ====================
\begin{pgfonlayer}{foreground}
  \node[
    anchor=north,
    text=themefg
  ] at (6.6, -0.75)
    {\footnotesize \textbf{联合分布基本法则：} 支撑集截面直接确定积分限 $\;\big\vert\;$ 边缘化是沿截面积分，条件化是在截面上重新归一化};
\end{pgfonlayer}

\end{tikzpicture}
