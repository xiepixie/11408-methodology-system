% ── V05 CDF 跳跃与区间概率 ──
\begin{tikzpicture}[
  scale=1.0,
  >=Stealth,
  font=\small,
  color=themefg,
  text=themefg
]

\pgfdeclarelayer{background}
\pgfdeclarelayer{foreground}
\pgfsetlayers{background,main,foreground}

% ══════════════════════════════════════════════════════════════
% ── 子图 1（左）：离散型阶梯跳跃与点质量 ──
% ══════════════════════════════════════════════════════════════
\begin{scope}[xshift=0cm, yshift=0cm]
  % 背景卡片
  \begin{pgfonlayer}{background}
    \fill[fill=themefg!6!themebg, draw=themegray!40, line width=0.6pt, rounded corners=3pt]
      (-0.2, -1.1) rectangle (4.6, 5.3);
  \end{pgfonlayer}

  % 标题
  \begin{pgfonlayer}{foreground}
    \node[anchor=north west] at (0.0, 5.15) {
      \textbf{\color{themecurve}1. 离散型：阶梯跳跃与点质量}
    };
  \end{pgfonlayer}

  % 阶梯 CDF 坐标轴图
  \begin{pgfonlayer}{background}
    \fill[fill=themebg, draw=themegray, line width=0.7pt, rounded corners=2pt]
      (0.2, 1.8) rectangle (4.2, 4.6);

    % 坐标轴
    \draw[color=themegray, line width=0.8pt, ->] (0.5, 2.1) -- (3.9, 2.1) node[right] {\tiny $x$};
    \draw[color=themegray, line width=0.8pt, ->] (0.8, 1.9) -- (0.8, 4.35) node[left] {\tiny $F$};

    % 渐近线 y=1
    \draw[color=themegray, line width=0.5pt, dashed] (0.8, 4.1) -- (3.8, 4.1) node[right] {\tiny $1$};

    % 阶梯水平线段
    \draw[color=themecurve, line width=1.2pt] (0.5, 2.1) -- (1.5, 2.1);
    \draw[color=themecurve, line width=1.2pt] (1.5, 2.8) -- (2.5, 2.8);
    \draw[color=themecurve, line width=1.2pt] (2.5, 3.6) -- (3.3, 3.6);
    \draw[color=themecurve, line width=1.2pt] (3.3, 4.1) -- (3.8, 4.1);

    % 右连续实心点与左极限空心点
    % x_1 = 1.5
    \draw[color=themecurve, line width=0.8pt] (1.5, 2.1) circle (1.5pt); % 空心
    \fill[color=themecurve] (1.5, 2.8) circle (1.8pt);                  % 实心
    \draw[color=themealert, line width=0.8pt, <->] (1.5, 2.15) -- (1.5, 2.75);

    % x_2 = 2.5
    \draw[color=themecurve, line width=0.8pt] (2.5, 2.8) circle (1.5pt); % 空心
    \fill[color=themecurve] (2.5, 3.6) circle (1.8pt);                  % 实心
    \draw[color=themealert, line width=0.8pt, <->] (2.5, 2.85) -- (2.5, 3.55);

    % x_3 = 3.3
    \draw[color=themecurve, line width=0.8pt] (3.3, 3.6) circle (1.5pt); % 空心
    \fill[color=themecurve] (3.3, 4.1) circle (1.8pt);                  % 实心
  \end{pgfonlayer}

  % 文字标注与说明 (Card 1)
  \begin{pgfonlayer}{foreground}
    \node[anchor=north, color=themefg] at (1.5, 2.05) {\tiny $x_1$};
    \node[anchor=north, color=themefg] at (2.5, 2.05) {\tiny $x_2$};
    \node[anchor=north, color=themefg] at (3.3, 2.05) {\tiny $x_3$};

    \node[anchor=west, color=themealert] at (1.55, 2.45) {\tiny $p_1$};
    \node[anchor=west, color=themealert] at (2.55, 3.2) {\tiny $p_2$};

    \node[anchor=north west, text width=4.3cm] at (0.0, 1.6) {
      \scriptsize $\bullet$ \textbf{点质量与跳跃高度}：\\[0.15em]
      \quad $P(X=x_k) = F(x_k) - F(x_k^-)$\\[0.1em]
      \quad （跳跃高度等于点质量 $p_k$）\\[0.2em]
      \scriptsize $\bullet$ \textbf{右连续性}：$F(x_k^+) = F(x_k)$（实心在上方）
    };
  \end{pgfonlayer}
\end{scope}

% ══════════════════════════════════════════════════════════════
% ── 子图 2（中）：连续型 CDF 与概率密度 PDF ──
% ══════════════════════════════════════════════════════════════
\begin{scope}[xshift=5.1cm, yshift=0cm]
  % 背景卡片
  \begin{pgfonlayer}{background}
    \fill[fill=themefg!6!themebg, draw=themegray!40, line width=0.6pt, rounded corners=3pt]
      (-0.2, -1.1) rectangle (4.6, 5.3);
  \end{pgfonlayer}

  % 标题
  \begin{pgfonlayer}{foreground}
    \node[anchor=north west] at (0.0, 5.15) {
      \textbf{\color{themeamber}2. 连续型：光滑上升与密度}
    };
  \end{pgfonlayer}

  % 光滑 CDF 与切线示意
  \begin{pgfonlayer}{background}
    \fill[fill=themebg, draw=themegray, line width=0.7pt, rounded corners=2pt]
      (0.2, 1.8) rectangle (4.2, 4.6);

    % 坐标轴
    \draw[color=themegray, line width=0.8pt, ->] (0.5, 2.1) -- (3.9, 2.1) node[right] {\tiny $x$};
    \draw[color=themegray, line width=0.8pt, ->] (0.8, 1.9) -- (0.8, 4.35) node[left] {\tiny $F$};
    \draw[color=themegray, line width=0.5pt, dashed] (0.8, 4.1) -- (3.8, 4.1) node[right] {\tiny $1$};

    % 光滑 S 形 CDF 曲线
    \draw[color=themeamber, line width=1.3pt, domain=0.6:3.8, samples=40, smooth]
      plot (\x, {2.1 + 2.0 / (1.0 + exp(-2.5*(\x - 2.2)))});

    % 切线斜率指示点 (x=2.2, y=3.1)
    \fill[color=themecurve] (2.2, 3.1) circle (2.0pt);
    \draw[color=themecurve, line width=0.9pt] (1.5, 2.2) -- (2.9, 4.0);
  \end{pgfonlayer}

  % 文字标注与说明
  \begin{pgfonlayer}{foreground}
    \node[anchor=north, color=themefg] at (2.2, 2.05) {\tiny $x_0$};
    \node[anchor=south west, color=themecurve] at (2.3, 3.25) {\scriptsize 斜率 $F'(x) = f(x)$};

    \node[anchor=north west, text width=4.3cm] at (0.0, 1.6) {
      \scriptsize $\bullet$ \textbf{概率密度}：$F'_X(x) = f_X(x)$（几乎处处）\\[0.25em]
      \scriptsize $\bullet$ \textbf{单点无质量}：$P(X=c) = 0$（零测度事件）
    };
  \end{pgfonlayer}
\end{scope}

% ══════════════════════════════════════════════════════════════
% ── 子图 3（右）：区间概率四种端点极限换算 ──
% ══════════════════════════════════════════════════════════════
\begin{scope}[xshift=10.2cm, yshift=0cm]
  % 背景卡片
  \begin{pgfonlayer}{background}
    \fill[fill=themefg!6!themebg, draw=themegray!40, line width=0.6pt, rounded corners=3pt]
      (-0.2, -1.1) rectangle (4.6, 5.3);
  \end{pgfonlayer}

  % 标题
  \begin{pgfonlayer}{foreground}
    \node[anchor=north west] at (0.0, 5.15) {
      \textbf{\color{themealert}3. 四种区间端点极限换算}
    };
  \end{pgfonlayer}

  % 区间换算法则卡片
  \begin{pgfonlayer}{background}
    \fill[fill=themebg, draw=themegray, line width=0.7pt, rounded corners=2pt]
      (0.2, 1.8) rectangle (4.2, 4.6);

    \fill[fill=themecurve!15!themebg, rounded corners=2pt] (0.35, 3.9) rectangle (4.05, 4.45);
    \fill[fill=themeamber!15!themebg, rounded corners=2pt] (0.35, 3.25) rectangle (4.05, 3.8);
    \fill[fill=themealert!15!themebg, rounded corners=2pt] (0.35, 2.6) rectangle (4.05, 3.15);
    \fill[fill=themefg!12!themebg, rounded corners=2pt] (0.35, 1.95) rectangle (4.05, 2.5);
  \end{pgfonlayer}

  % 文字标注与说明
  \begin{pgfonlayer}{foreground}
    \node[anchor=west] at (0.5, 4.18) {\scriptsize \textbf{\color{themecurve}半开 $(a, b]$}：$F(b) - F(a)$};
    \node[anchor=west] at (0.5, 3.53) {\scriptsize \textbf{\color{themeamber}全闭 $[a, b]$}：$F(b) - F(a^-)$};
    \node[anchor=west] at (0.5, 2.88) {\scriptsize \textbf{\color{themealert}全开 $(a, b)$}：$F(b^-) - F(a)$};
    \node[anchor=west] at (0.5, 2.23) {\scriptsize \textbf{半闭 $[a, b)$}：$F(b^-) - F(a^-)$};

    \node[anchor=north west, text width=4.3cm] at (0.0, 1.6) {
      \scriptsize $\bullet$ \textbf{端点判定法则}：\\[0.15em]
      \quad 左含端点取左极限 $F(a^-)$；\\[0.15em]
      \quad 右不含端点取左极限 $F(b^-)$；\\[0.15em]
      \quad 连续型下退化为 $F(b)-F(a)$。
    };
  \end{pgfonlayer}
\end{scope}

% ══════════════════════════════════════════════════════════════
% ── 底部全图全局总结 (无框轻量排印) ──
% ══════════════════════════════════════════════════════════════
\begin{pgfonlayer}{foreground}
  \node[anchor=north, text=themefg, text width=14.8cm, align=center] at (7.3, -1.25) {
    \footnotesize \textbf{CDF 母表示核心准则：} 分布函数 $F(x)$ 满足单调不减、右连续与两端极限；\textbf{跳跃高度 $F(x)-F(x^-)$ 唯一确定点质量}；区间概率严格由左右极限决定。
  };
\end{pgfonlayer}

\end{tikzpicture}
