\begin{tikzpicture}[color=themefg,text=themefg,>=Stealth,x=1.2cm,y=1.2cm]
  \tikzset{
    axis/.style={themegray,line width=0.8pt,-{Stealth[length=1.6mm]}},
    curve/.style={themecurve,line width=2.0pt},
    secant1/.style={themeamber,densely dashed,line width=1.0pt},
    secant2/.style={themegreen,densely dashed,line width=1.0pt},
    tangent1/.style={themeamber,line width=1.3pt},
    tangent2/.style={themegreen,line width=1.3pt},
    guide/.style={themegray,densely dotted,line width=0.7pt},
    splitline/.style={themealert,densely dashed,line width=1.1pt},
    tag/.style={fill=themebg,inner sep=1.5pt,font=\small}
  }

  % Coordinates: a=0.5, c=4.2, b=8.0
  \draw[axis] (-0.2,0) -- (8.8,0) node[below,font=\small] {$x$};
  \draw[axis] (0,-0.2) -- (0,5.2) node[left,font=\small] {$y$};

  % Function curve f(x)
  \draw[curve] plot[domain=0.5:8.0,samples=100] (\x,{1.3+0.35*\x+0.7*sin(65*\x)});
  \node[text=themecurve,anchor=south west,font=\small] at (7.8,4.4) {$y=f(x)$};

  % Sub-interval boundaries
  \draw[guide] (0.5,0) -- (0.5,1.85);
  \draw[splitline] (4.2,0) -- (4.2,4.8);
  \draw[guide] (8.0,0) -- (8.0,4.34);

  \fill[themecurve] (0.5,1.85) circle (2.0pt);
  \fill[themealert] (4.2,2.07) circle (2.2pt);
  \fill[themecurve] (8.0,4.34) circle (2.0pt);

  % Secant 1 on [a, c] (slope = 0.06)
  \draw[secant1] (0.5,1.85) -- (4.2,2.07);

  % Secant 2 on [c, b] (slope = 0.60)
  \draw[secant2] (4.2,2.07) -- (8.0,4.34);

  % Tangent 1 at xi_1 = 1.72 (parallel to Secant 1)
  \draw[guide] (1.72,0) -- (1.72,2.55);
  \fill[themeamber] (1.72,2.55) circle (2.2pt);
  \draw[tangent1] (0.6,2.48) -- (2.9,2.62);
  \node[text=themeamber,anchor=south,font=\footnotesize] at (2.2,2.95) {切线斜率 $f'(\xi_1) = \dfrac{f(c)-f(a)}{c-a}$};
  \draw[themegray,densely dotted] (2.2,2.9) -- (1.72,2.55);

  % Tangent 2 at xi_2 = 6.64 (parallel to Secant 2)
  \draw[guide] (6.64,0) -- (6.64,4.29);
  \fill[themegreen] (6.64,4.29) circle (2.2pt);
  \draw[tangent2] (5.4,3.55) -- (7.8,4.98);
  \node[text=themegreen,anchor=south,font=\footnotesize] at (5.8,4.75) {切线斜率 $f'(\xi_2) = \dfrac{f(b)-f(c)}{b-c}$};
  \draw[themegray,densely dotted] (5.8,4.7) -- (6.64,4.29);

  % X-axis Labels
  \node[tag,anchor=north,font=\small] at (0.5,-0.05) {$a$};
  \node[tag,text=themealert,anchor=north,font=\small\bfseries] at (4.2,-0.05) {$c$ (插点)};
  \node[tag,anchor=north,font=\small] at (8.0,-0.05) {$b$};

  \node[tag,text=themeamber,anchor=north,font=\small] at (1.72,-0.05) {$\xi_1$};
  \node[tag,text=themegreen,anchor=north,font=\small] at (6.64,-0.05) {$\xi_2$};

  % Bottom summary
  \node[font=\small,text=themegray,anchor=north] at (4.2,-0.85)
  {$[a,b]\to[a,c]\cup[c,b]$：多个中值点的严格相异（$\xi_1 < c < \xi_2$）由区间物理分离严格保证。};
\end{tikzpicture}
