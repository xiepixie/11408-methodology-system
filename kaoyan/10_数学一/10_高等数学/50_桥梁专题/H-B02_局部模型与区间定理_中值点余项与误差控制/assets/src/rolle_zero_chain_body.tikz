\begin{tikzpicture}[color=themefg,text=themefg,>=Stealth,x=1.05cm,y=1.15cm]
  \tikzset{
    axis/.style={themegray,line width=0.8pt,-{Stealth[length=1.6mm]}},
    zerol0/.style={fill=themealert,draw=themebg,line width=0.8pt,circle,inner sep=2.2pt},
    zerol1/.style={fill=themeamber,draw=themebg,line width=0.8pt,circle,inner sep=2.0pt},
    zerol2/.style={fill=themecurve,draw=themebg,line width=0.8pt,circle,inner sep=2.0pt},
    zerotop/.style={fill=themealert,draw=themebg,line width=1.0pt,circle,inner sep=2.6pt},
    guide/.style={themegray,densely dotted,line width=0.7pt},
    arr/.style={themeamber,line width=1.0pt,-{Stealth[length=1.7mm]}},
    tag/.style={fill=themebg,inner sep=1.2pt,font=\small},
    badge/.style={draw=themegray,fill=themebg,rounded corners=1mm,inner sep=2pt,font=\footnotesize}
  }

  % ═════════════════════════════════════════════════════════════════════════════
  % Level 0: Phi has n+2 zeros (x0, x1, x2, x3, x) at y = 4.2
  % ═════════════════════════════════════════════════════════════════════════════
  \draw[axis] (-0.3,4.2) -- (8.1,4.2) node[below,font=\footnotesize] {$t$};
  \node[anchor=east,font=\small] at (-0.5,4.2) {$\Phi(t)$};
  \node[badge,text=themealert,anchor=west] at (8.6,4.2) {$n+2$ 个零点};
  \foreach \x/\lbl in {0.8/x_0, 2.3/x_1, 4.1/x_2, 5.8/x_3, 7.6/x}{
    \node[zerol0] at (\x,4.2) {};
    \node[tag,anchor=south,font=\footnotesize] at (\x,4.32) {$\lbl$};
  }

  % ═════════════════════════════════════════════════════════════════════════════
  % Level 1: Phi' has n+1 zeros at y = 2.8
  % ═════════════════════════════════════════════════════════════════════════════
  \draw[axis] (-0.3,2.8) -- (8.1,2.8) node[below,font=\footnotesize] {$t$};
  \node[anchor=east,font=\small] at (-0.5,2.8) {$\Phi'(t)$};
  \node[badge,text=themeamber,anchor=west] at (8.6,2.8) {$n+1$ 个零点};
  \foreach \x/\lbl in {1.55/\xi_1^{(1)}, 3.2/\xi_2^{(1)}, 4.95/\xi_3^{(1)}, 6.7/\xi_4^{(1)}}{
    \node[zerol1] at (\x,2.8) {};
    \node[tag,anchor=north,font=\footnotesize] at (\x,2.68) {$\lbl$};
  }

  % Connections Level 0 -> Level 1 (Rolle in each interval)
  \draw[guide] (0.8,4.2) -- (1.55,2.8) -- (2.3,4.2);
  \draw[guide] (2.3,4.2) -- (3.2,2.8) -- (4.1,4.2);
  \draw[guide] (4.1,4.2) -- (4.95,2.8) -- (5.8,4.2);
  \draw[guide] (5.8,4.2) -- (6.7,2.8) -- (7.6,4.2);
  \draw[arr] (-0.4,3.9) -- node[left,font=\footnotesize,text=themeamber]{Rolle} (-0.4,3.1);

  % ═════════════════════════════════════════════════════════════════════════════
  % Level 2: Phi'' has n zeros at y = 1.4
  % ═════════════════════════════════════════════════════════════════════════════
  \draw[axis] (-0.3,1.4) -- (8.1,1.4) node[below,font=\footnotesize] {$t$};
  \node[anchor=east,font=\small] at (-0.5,1.4) {$\Phi''(t)$};
  \node[badge,text=themecurve,anchor=west] at (8.6,1.4) {$n$ 个零点};
  \foreach \x/\lbl in {2.38/\xi_1^{(2)}, 4.08/\xi_2^{(2)}, 5.83/\xi_3^{(2)}}{
    \node[zerol2] at (\x,1.4) {};
    \node[tag,anchor=north,font=\footnotesize] at (\x,1.28) {$\lbl$};
  }
  \draw[guide] (1.55,2.8) -- (2.38,1.4) -- (3.2,2.8);
  \draw[guide] (3.2,2.8) -- (4.08,1.4) -- (4.95,2.8);
  \draw[guide] (4.95,2.8) -- (5.83,1.4) -- (6.7,2.8);
  \draw[arr] (-0.4,2.5) -- node[left,font=\footnotesize,text=themeamber]{Rolle} (-0.4,1.7);

  % Contraction dots
  \node[font=\normalsize,text=themegray] at (4.08,0.7) {$\vdots$};
  \node[font=\normalsize,text=themegray] at (-0.4,0.7) {$\vdots$};
  \draw[themegray,densely dashed,line width=0.8pt] (0.8,4.2) -- (4.08,-0.1) -- (7.6,4.2);

  % ═════════════════════════════════════════════════════════════════════════════
  % Level n+1: single witness point xi at y = -0.1
  % ═════════════════════════════════════════════════════════════════════════════
  \draw[axis] (-0.3,-0.1) -- (8.1,-0.1) node[below,font=\footnotesize] {$t$};
  \node[anchor=east,font=\small] at (-0.5,-0.1) {$\Phi^{(n+1)}(t)$};
  \node[badge,text=themealert,anchor=west] at (8.6,-0.1) {$1$ 个高阶见证点};
  \node[zerotop] at (4.08,-0.1) {};
  \node[tag,text=themealert,anchor=south,font=\small\bfseries] at (4.08,0.06) {$\xi$};

  % Bottom summary
  \node[font=\small,text=themegray,anchor=north] at (4.1,-0.8)
  {$\Phi(t)=f(t)-P_n(t)-K\Pi(t)$：插值约束制造 $n+2$ 个零点，经 Rolle 链逐层收缩汇聚至 $\Phi^{(n+1)}(\xi)=0$。};
\end{tikzpicture}
