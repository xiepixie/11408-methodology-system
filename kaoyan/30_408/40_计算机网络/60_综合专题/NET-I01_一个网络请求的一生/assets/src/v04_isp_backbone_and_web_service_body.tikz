% ── NET-I01 Canonical Main Topology: ISP Backbone and Web Service ──
\begin{tikzpicture}[
  scale=1.0,
  >=Stealth,
  font=\small,
  color=themefg,
  text=themefg,
  host/.style={draw=themegreen,fill=themegreen!18!themebg,rounded corners=4pt,minimum width=2.6cm,minimum height=1.30cm,align=center,font=\small\bfseries,line width=1.1pt},
  bridge/.style={draw=themegray,fill=themefg!8!themebg,rounded corners=4pt,minimum width=2.3cm,minimum height=1.20cm,align=center,font=\small\bfseries,line width=1.1pt},
  router/.style={circle,draw=themecurve,fill=themecurve!18!themebg,minimum size=1.50cm,align=center,font=\small\bfseries,line width=1.2pt},
  borderrouter/.style={circle,draw=themeamber,fill=themeamber!22!themebg,minimum size=1.55cm,align=center,font=\small\bfseries,line width=1.3pt},
  server/.style={draw=themeamber,fill=themeamber!20!themebg,rounded corners=4pt,minimum width=2.8cm,minimum height=1.35cm,align=center,font=\small\bfseries,line width=1.2pt},
  sideservice/.style={draw=themeamber,fill=themeamber!15!themebg,rounded corners=4pt,minimum width=2.7cm,minimum height=1.05cm,align=center,font=\scriptsize\bfseries,line width=1.0pt},
  flowline/.style={->,draw=themefg!85,line width=1.3pt},
  wanline/.style={->,draw=themecurve,line width=1.6pt},
  bgpline/.style={<->,draw=themealert,dashed,line width=1.3pt},
  serviceline/.style={-,draw=themefg!70,line width=1.0pt}
]

% ══════════════════════════════════════════════════════════════
% ── 1. 背景语义分层底盒（严格保证纵向空间充足，绝不与标题压字）──
% ══════════════════════════════════════════════════════════════

\begin{pgfonlayer}{background}
  % 作用域一：局域接入网 (y = 10.0 ~ 15.6)
  \fill[fill=themegreen!7!themebg,draw=themegreen!55,dashed,line width=1.0pt,rounded corners=8pt]
    (0.0, 10.0) rectangle (20.5, 15.6);
  % 作用域二：运营商骨干网 (y = 4.8 ~ 9.5)
  \fill[fill=themecurve!7!themebg,draw=themecurve!55,dashed,line width=1.0pt,rounded corners=8pt]
    (0.0, 4.8) rectangle (20.5, 9.5);
  % 作用域三：数据中心网络 (y = 1.1 ~ 4.3)
  \fill[fill=themeamber!7!themebg,draw=themeamber!55,dashed,line width=1.0pt,rounded corners=8pt]
    (0.0, 1.1) rectangle (20.5, 4.3);
  % 底部结论栏 (y = -1.2 ~ 0.7)
  \fill[fill=themecurve!8!themebg,draw=themecurve!50,line width=0.9pt,rounded corners=6pt]
    (0.0, -1.2) rectangle (20.5, 0.7);
\end{pgfonlayer}

\begin{pgfonlayer}{foreground}
  \node[anchor=west,font=\normalsize\bfseries,color=themegreen] at (0.3, 15.1) {【作用域一】校园网 / 家庭局域网 (Campus / Home LAN $\cdot$ VLAN 10)};
  \node[anchor=west,font=\normalsize\bfseries,color=themecurve] at (0.3, 9.0) {【作用域二】运营商核心骨干网 (ISP 骨干网 $\cdot$ AS64501)};
  \node[anchor=west,font=\normalsize\bfseries,color=themeamber] at (0.3, 3.85) {【作用域三】内容提供商服务集群 (数据中心网络 $\cdot$ AS64502)};
\end{pgfonlayer}

% ══════════════════════════════════════════════════════════════
% ── 2. 作用域一：局域接入节点 (y = 13.0) ──
% ══════════════════════════════════════════════════════════════

\node[host] (sta) at (1.8, 13.0) {STA 客户端主机\\\scriptsize 192.168.10.23\\\tiny 默认网关: 192.168.10.1};
\node[bridge] (ap) at (6.6, 13.0) {无线 AP\\\scriptsize 802.11/802.3 桥接\\\tiny 二层设备不消耗 TTL};
\node[bridge] (sw) at (11.6, 13.0) {二层交换机 SW\\\scriptsize MAC 自学习转发\\\tiny 划分 VLAN 10};
\node[router] (r1) at (16.8, 13.0) {出口网关 R1\\\scriptsize 三层路由器};

\node[anchor=south,font=\tiny,color=themegray,align=center] at (16.8, 13.85) {
  \textbf{内网:} \texttt{192.168.10.1} \ \textbf{外网:} \texttt{198.51.100.9}\\
  NAPT 地址转换 + DHCP 中继代理
};

\draw[flowline] (sta) -- node[above=2pt,font=\scriptsize\bfseries,color=themegreen]{802.11 无线信道} node[below=1pt,font=\tiny,color=themegray]{CSMA/CA 介质访问} (ap);
\draw[flowline] (ap) -- node[above=2pt,font=\scriptsize\bfseries,color=themegreen]{802.3 双绞线} node[below=1pt,font=\tiny,color=themegray]{Ethernet 帧} (sw);
\draw[flowline] (sw) -- node[above=2pt,font=\scriptsize\bfseries,color=themegreen]{VLAN 10 内部互联} node[below=1pt,font=\tiny,color=themegray]{Ethernet 链路} (r1);

% ══════════════════════════════════════════════════════════════
% ── 3. 作用域二：骨干网络节点 (y = 7.5，避开 y = 9.0 标题) ──
% ══════════════════════════════════════════════════════════════

\node[router] (r2) at (16.8, 7.5) {边缘路由 R2\\\scriptsize 接入 ISP 骨干};

\draw[wanline] (r1) -- node[right=4pt,font=\scriptsize\bfseries,color=themecurve,align=left] {
  Native PPP 光纤专线\\
  \tiny \color{themealert} (点对点链路 $\cdot$ 无 Ethernet MAC)
} (r2);

\node[router] (core1) at (9.6, 7.5) {核心路由 Core1\\\scriptsize 骨干转发};
\node[borderrouter] (br1) at (2.4, 7.5) {边界路由 BR1\\\scriptsize AS 边界出口};

\draw[wanline] (r2) -- node[above=2pt,font=\scriptsize\bfseries,color=themecurve]{ISP 内部链路} node[below=1pt,font=\tiny,color=themegray]{OSPF 维护域内路由} (core1);
\draw[wanline] (core1) -- node[above=2pt,font=\scriptsize\bfseries,color=themecurve]{ISP 内部链路} node[below=1pt,font=\tiny,color=themegray]{数据报按已安装 FIB 转发} (br1);

\node[sideservice] (dns) at (7.0, 5.6) {递归 DNS 服务器\\\scriptsize 192.0.2.53 / DNS 53\\\tiny 主场景按常见 UDP 查询};
\node[sideservice] (dhcp) at (13.5, 5.6) {DHCP 服务器\\\scriptsize 192.0.2.67 / UDP 67\\\tiny 由 R1 Relay 访问};
\draw[serviceline] (core1.south) -- (dns.north);
\draw[serviceline] (r2.south) -- (dhcp.north);

% ══════════════════════════════════════════════════════════════
% ── 4. 作用域三：数据中心网络 (y = 2.4，避开 y = 3.85 标题) ──
% ══════════════════════════════════════════════════════════════

\node[borderrouter] (br2) at (2.4, 2.4) {边界路由 BR2\\\scriptsize AS 边界入口};

\draw[flowline] (br1) -- node[left=4pt,font=\scriptsize\bfseries,color=themefg]{AS 间链路} (br2);
\draw[bgpline] ([xshift=5pt]br1.south) -- node[right=5pt,font=\scriptsize\bfseries,color=themealert,align=left] {
  eBGP 路由信息交换\\
  \tiny \color{themegray} AS64501 $\leftrightarrow$ AS64502
} ([xshift=5pt]br2.north);

\node[router] (rn) at (9.6, 2.4) {服务网关 Rn\\\scriptsize 数据中心网关};
\node[server] (web) at (16.8, 2.4) {Web 服务器\\\scriptsize \texttt{www.example.test}\\\tiny IP: 203.0.113.80 / Port: 80};

\draw[wanline] (br2) -- node[above=2pt,font=\scriptsize\bfseries,color=themeamber]{内容网内部链路} node[below=1pt,font=\tiny,color=themegray]{IGP 维护域内路由} (rn);
\draw[flowline,draw=themeamber] (rn) -- node[above=2pt,font=\scriptsize\bfseries,color=themeamber]{服务器以太网} node[below=1pt,font=\tiny,color=themegray]{通过 ARP 查询 Web 服务器 MAC} (web);

% ══════════════════════════════════════════════════════════════
% ── 5. 底部核心结论底栏 ──
% ══════════════════════════════════════════════════════════════

\node[anchor=west,font=\normalsize\bfseries,color=themecurve] at (0.3, 0.40) {★ 读这张拓扑时注意三件事：};
\node[anchor=west,font=\footnotesize\bfseries,color=themefg] at (0.3, 0.0) {
  1. \textbf{DNS / DHCP 是网络服务}：客户端访问它们也要正常查 FIB、逐跳转发；图中不再画成客户端物理直连；
};
\node[anchor=west,font=\footnotesize\bfseries,color=themefg] at (0.3, -0.40) {
  2. \textbf{设备职责不同}：R1 可改写源 IP/Port；二层交换机只按 MAC 表和 STP 状态转发，不消耗 TTL；
};
\node[anchor=west,font=\footnotesize\bfseries,color=themefg] at (0.3, -0.75) {
  3. \textbf{不同链路使用不同本跳表示}：Native PPP 没有 Ethernet MAC；最后一跳 Ethernet 由 Rn 通过 ARP 得到 Web 服务器 MAC。
};

\end{tikzpicture}
