]

% ══════════════════════════════════════════════════════════════
% ── 1. 底层连线与区域虚线背景 ──
% ══════════════════════════════════════════════════════════════
\begin{pgfonlayer}{background}
  % 家庭内网背景淡色包络
  \fill[fill=themecurve!6!themebg, draw=themecurve!30, dashed, line width=0.6pt, rounded corners=6pt]
    (-0.5, 4.2) rectangle (5.6, 12.4);
  \node[anchor=north west, font=\footnotesize\bfseries, color=themecurve] at (-0.3, 12.2) {家庭私有内网 (192.168.3.0/24)};

  % 家庭内连线：电脑/电视 -> 交换机，手机 -> AP -> 交换机
  \draw[themegray!80, line width=1.0pt] (1.2, 9.8) -- (2.8, 7.5);
  \draw[themegray!80, line width=1.0pt] (1.2, 5.2) -- (2.8, 6.9);
  \draw[themeamber!60, line width=0.8pt, dashed] (4.2, 9.8) -- (4.2, 7.9);
  \draw[themegray!80, line width=1.0pt] (4.2, 7.2) -- (3.2, 7.2);

  % 交换机 -> NAT 路由器 LAN
  \draw[themegray!80, line width=1.0pt] (2.8, 6.7) -- (2.8, 3.2);

  % NAT 路由器 WAN -> 咸鱼电信路由器 F3
  \draw[themegray!80, line width=1.0pt] (3.45, 2.5) -- (8.8, 2.5)
    node[midway, above, font=\tiny\bfseries, color=themeamber] {128.14.32.152/30 (F3: .154 $\leftrightarrow$ WAN: .153)};

  % 咸鱼电信路由器 -> 旺财家 (F2)
  \draw[themegray!80, line width=1.0pt] (9.5, 1.8) -- (9.5, 0.7)
    node[midway, right, font=\tiny, color=themegray] {F2: 128.14.32.144/29};

  % 咸鱼电信路由器 -> 铁柱网吧 (F1)
  \draw[themegray!80, line width=1.0pt] (10.2, 2.5) -- (14.8, 2.5)
    node[midway, above, font=\tiny\bfseries, color=themecurve] {F1: 128.14.32.128/28};

  % 咸鱼电信路由器 (F0) -> 县里电信路由器 (G1)
  \draw[themealert!80, line width=1.2pt] (9.5, 3.2) -- (9.5, 8.1)
    node[midway, left, font=\tiny\bfseries, color=themealert] {0.0.0.0/0 (F0 $\to$ G1)};

  % 县里路由器 -> Internet (G0)
  \draw[themegray!80, line width=1.0pt, ->] (9.5, 9.5) -- (9.5, 11.2)
    node[anchor=south, font=\tiny\bfseries, color=themegray] {G0: 0.0.0.0/0 (核心骨干网)};

  % 县里路由器 G3 -> 铁柱网吧明细链路 (示范 LPM)
  \draw[themeamber!80, line width=1.0pt, dashed] (10.2, 8.8) -- (16.9, 8.8) -- (16.9, 3.5);
\end{pgfonlayer}

