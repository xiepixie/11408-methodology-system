% ══════════════════════════════════════════════════════════════
% ── 6. 底部考点总结卡片（无框通栏，宽裕呼吸感） ──
% ══════════════════════════════════════════════════════════════
\begin{scope}[xshift=-0.5cm, yshift=-4.0cm]
  \begin{pgfonlayer}{background}
    \fill[fill=themefg!4!themebg, draw=themegray!30, line width=0.6pt, rounded corners=4pt]
      (-0.3, -0.4) rectangle (19.4, 2.8);
  \end{pgfonlayer}
  \begin{pgfonlayer}{foreground}
    \node[anchor=north west, text width=19.0cm] at (0.0, 2.45) {
      \small \textbf{\color{themecurve}核心考点精要与机制辨析：}\\[0.4em]
      \scriptsize $\bullet$ \textbf{CIDR 二进制子网划分}：借用主机号最高位作为子网号（/16 拆两个 /17，掩码均为 255.255.128.0）；每个子网拥有 $2^{15}=32768$ 个 IP，扣除全 0 网络地址与全 1 广播地址后，可用主机地址数均为 $2^{15}-2=32766$ 个。\\[0.3em]
      \scriptsize $\bullet$ \textbf{DHCP 动态配置工作流 (DORA 4 步报文)}：① \textbf{Discover}（客户机 UDP:68 广播寻找 DHCP，源 0.0.0.0，目的 255.255.255.255）$\to$ ② \textbf{Offer}（服务器 UDP:67 提供预选 IP/掩码/网关）$\to$ ③ \textbf{Request}（客户机广播确认接受预选）$\to$ ④ \textbf{ACK}（服务器正式确认租约）。跨子网广播需配置 \textbf{DHCP 中继代理 (Relay Agent)}。\\[0.3em]
      \scriptsize $\bullet$ \textbf{默认网关 (Default Gateway) 交付语义}：主机向跨网段 IP 发送分组时，先通过 ARP 广播查询默认网关（如 B3: 166.1.0.5）的 MAC 地址，将数据帧目的 MAC 封装为网关 MAC，由网关在网络层执行路由转发。
    };
  \end{pgfonlayer}
\end{scope}

\end{tikzpicture}
