    \draw[themegreen, line width=1.0pt, ->] (17.9, -5.12) -- (17.9, -5.25);

    \draw[themealert, line width=1.0pt, ->] (20.4, -4.5) -- (20.4, -4.78);
    \draw[themealert, line width=1.0pt, ->] (20.4, -5.12) -- (20.4, -5.25);

    % 总结结论文字
    \node[anchor=west, font=\small\bfseries, color=themecurve] at (-12.6, -6.32) {★ 408 核心分用辨析结论：};
    \node[anchor=west, font=\footnotesize\bfseries, color=themefg] at (-12.6, -6.72) {
      1. \textbf{ARP} 由链路层直承 (无 IP 首部，Type=\texttt{0x0806})；\quad
      2. \textbf{ICMP} 属网络层但由 IP 封装 (Protocol=\textbf{1})；\quad
      3. \textbf{OSPF} 属路由协议直连 IP (Protocol=\textbf{89})；\quad
      4. \textbf{RIP} (UDP 520) 与 \textbf{BGP} (TCP 179) 借用传输层！
    };
  \end{pgfonlayer}
\end{scope}

\end{tikzpicture}
