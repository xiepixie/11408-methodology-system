% ── V01 协议分层封装结构与分用解包全景图 ──
\begin{tikzpicture}[
  scale=1.0,
  >=Stealth,
  font=\small,
  color=themefg,
  text=themefg
]

% ══════════════════════════════════════════════════════════════
% ── 1. 上半部：物理与字节尺寸展开（协议封装“套娃”层级图）──
% ══════════════════════════════════════════════════════════════

% 大区段标题
\begin{pgfonlayer}{foreground}
  \node[anchor=west, font=\large\bfseries, color=themecurve] at (-13.0, 11.4) {一、协议纵向分层封装结构与字节开销（PDU 逐层包裹与首尾叠加）};
\end{pgfonlayer}

% ── L7 应用层 ──
\begin{scope}[yshift=9.2cm]
  \begin{pgfonlayer}{background}
    % 左侧层级胶囊 (绿)
    \fill[fill=themegreen!18!themebg, draw=themegreen, line width=1.1pt, rounded corners=4pt]
      (-13.0, 0) rectangle (-9.0, 1.45);
    % 应用层载荷 (绿)
    \fill[fill=themegreen!20!themebg, draw=themegreen, line width=1.2pt, rounded corners=4pt]
      (8.0, 0) rectangle (20.0, 1.45);
    % 梯形投影带 L7 -> L4 (绿色系)
    \fill[fill=themegreen!12!themebg, draw=themegreen!60, dashed, line width=0.7pt]
      (8.0, 0) -- (8.0, -0.85) -- (20.0, -0.85) -- (20.0, 0) -- cycle;
  \end{pgfonlayer}
  \begin{pgfonlayer}{foreground}
    \node[font=\normalsize\bfseries, color=themegreen, align=center] at (-11.0, 0.72) {L7 应用层\\\scriptsize (Application Message)};
    \node[font=\normalsize\bfseries, color=themegreen] at (14.0, 0.95) {应用层数据载荷 (Application Data / Message)};
    \node[font=\footnotesize\bfseries, color=themefg] at (14.0, 0.45) {HTTP 请求/响应报文 $\cdot$ DNS 查询应答 $\cdot$ FTP 文件数据 $\cdot$ SMTP/POP3 邮件};
  \end{pgfonlayer}
\end{scope}

% ── L4 传输层 ──
\begin{scope}[yshift=6.9cm]
  \begin{pgfonlayer}{background}
    % 左侧层级胶囊 (琥珀)
    \fill[fill=themeamber!18!themebg, draw=themeamber, line width=1.1pt, rounded corners=4pt]
      (-13.0, 0) rectangle (-9.0, 1.45);
    % TCP/UDP 首部 (琥珀)
    \fill[fill=themeamber!28!themebg, draw=themeamber, line width=1.2pt, rounded corners=4pt]
      (2.5, 0) rectangle (8.0, 1.45);
    % 传输层载荷 (套娃槽：承接上层 L7 报文，继承绿色语义底色)
    \fill[fill=themegreen!12!themebg, draw=themegreen!70, line width=1.0pt, rounded corners=3pt]
      (8.0, 0) rectangle (20.0, 1.45);
    % 梯形投影带 L4 -> L3 (琥珀色系)
    \fill[fill=themeamber!12!themebg, draw=themeamber!60, dashed, line width=0.7pt]
      (2.5, 0) -- (2.5, -0.85) -- (20.0, -0.85) -- (20.0, 0) -- cycle;
  \end{pgfonlayer}
  \begin{pgfonlayer}{foreground}
    \node[font=\normalsize\bfseries, color=themeamber, align=center] at (-11.0, 0.72) {L4 传输层\\\scriptsize (Transport Segment)};
    % TCP/UDP 首部文字 (高对比度)
    \node[font=\small\bfseries, color=themeamber] at (5.25, 1.05) {TCP / UDP 传输层首部};
    \node[font=\footnotesize\bfseries, color=themefg] at (5.25, 0.70) {20B (TCP 固定) / 8B (UDP 固定)};
    \node[font=\scriptsize\bfseries, color=themefg] at (5.25, 0.32) {源/目端口 $\cdot$ 序号/确认号 $\cdot$ 控制位 Flags};
    % 载荷文字
    \node[font=\normalsize\bfseries, color=themegreen] at (14.0, 0.95) {TCP / UDP 数据载荷};
    \node[font=\footnotesize\bfseries, color=themefg] at (14.0, 0.45) {（即上层完整的 L7 应用层报文，受 MSS 限制分段）};
  \end{pgfonlayer}
\end{scope}

% ── L3 网络层 ──
\begin{scope}[yshift=4.6cm]
  \begin{pgfonlayer}{background}
    % 左侧层级胶囊 (天蓝)
    \fill[fill=themecurve!18!themebg, draw=themecurve, line width=1.1pt, rounded corners=4pt]
      (-13.0, 0) rectangle (-9.0, 1.45);
    % IPv4/v6 首部 (天蓝)
    \fill[fill=themecurve!28!themebg, draw=themecurve, line width=1.2pt, rounded corners=4pt]
      (-3.0, 0) rectangle (2.5, 1.45);
    % IP 数据报载荷 (套娃槽：承接上层 L4 报文段，继承琥珀金语义底色)
    \fill[fill=themeamber!12!themebg, draw=themeamber!70, line width=1.0pt, rounded corners=3pt]
      (2.5, 0) rectangle (20.0, 1.45);
    % 梯形投影带 L3 -> L2 (天蓝色系)
    \fill[fill=themecurve!12!themebg, draw=themecurve!60, dashed, line width=0.7pt]
      (-3.0, 0) -- (-3.0, -0.85) -- (20.0, -0.85) -- (20.0, 0) -- cycle;
  \end{pgfonlayer}
  \begin{pgfonlayer}{foreground}
    \node[font=\normalsize\bfseries, color=themecurve, align=center] at (-11.0, 0.72) {L3 网络层\\\scriptsize (Network Packet)};
    % IP 首部文字 (高对比度)
    \node[font=\small\bfseries, color=themecurve] at (-0.25, 1.05) {IPv4 / IPv6 数据报首部};
    \node[font=\footnotesize\bfseries, color=themefg] at (-0.25, 0.70) {20~60B (v4) / 40B (v6 固定)};
    \node[font=\scriptsize\bfseries, color=themefg] at (-0.25, 0.32) {TTL (8b) $\cdot$ \textbf{Protocol (8b)} $\cdot$ 源/目 IP 地址};
    % 载荷文字
    \node[font=\normalsize\bfseries, color=themeamber] at (11.25, 0.95) {IP 数据报数据载荷 (包含 L4 首部与数据)};
    \node[font=\footnotesize\bfseries, color=themefg] at (11.25, 0.45) {（承载完整传输层报文段，受出接口 MTU 限制分片，通常 $\le 1480$B）};
  \end{pgfonlayer}
\end{scope}

% ── L2 数据链路层 ──
\begin{scope}[yshift=2.3cm]
  \begin{pgfonlayer}{background}
    % 左侧层级胶囊 (珊瑚红)
    \fill[fill=themealert!18!themebg, draw=themealert, line width=1.1pt, rounded corners=4pt]
      (-13.0, 0) rectangle (-9.0, 1.45);
    % MAC 首部 (珊瑚红)
    \fill[fill=themealert!28!themebg, draw=themealert, line width=1.2pt, rounded corners=4pt]
      (-8.5, 0) rectangle (-3.0, 1.45);
    % 帧数据载荷 (套娃槽：承接上层整个 L3 IP 数据报，继承天蓝语义底色)
    \fill[fill=themecurve!12!themebg, draw=themecurve!70, line width=1.0pt, rounded corners=3pt]
      (-3.0, 0) rectangle (20.0, 1.45);
    % FCS 尾部 (珊瑚红)
    \fill[fill=themealert!28!themebg, draw=themealert, line width=1.2pt, rounded corners=4pt]
      (20.0, 0) rectangle (22.8, 1.45);
    % 梯形投影带 L2 -> L1 (珊瑚红色系)
    \fill[fill=themealert!12!themebg, draw=themealert!60, dashed, line width=0.7pt]
      (-8.5, 0) -- (-8.5, -0.85) -- (22.8, -0.85) -- (22.8, 0) -- cycle;
  \end{pgfonlayer}
  \begin{pgfonlayer}{foreground}
    \node[font=\normalsize\bfseries, color=themealert, align=center] at (-11.0, 0.72) {L2 链路层\\\scriptsize (Data Link Frame)};
    % MAC 首部文字 (高对比度)
    \node[font=\small\bfseries, color=themealert] at (-5.75, 1.05) {以太网 MAC 帧首部};
    \node[font=\footnotesize\bfseries, color=themefg] at (-5.75, 0.70) {14 字节 \textnormal{\scriptsize(+4B 802.1Q Tag)}};
    \node[font=\scriptsize\bfseries, color=themefg] at (-5.75, 0.32) {目的MAC(6B) + 源MAC(6B) + \textbf{\color{themealert}Type(2B)}};
    % 载荷文字
    \node[font=\normalsize\bfseries, color=themecurve] at (8.5, 0.95) {以太网帧数据载荷 (Ethernet Frame Payload)};
    \node[font=\footnotesize\bfseries, color=themefg] at (8.5, 0.45) {（即完整的 L3 IP 数据报，有效净荷要求：\textbf{46B $\sim$ 1500B MTU}）};
    % FCS 尾部文字
    \node[font=\small\bfseries, color=themealert] at (21.4, 0.95) {FCS 尾部};
    \node[font=\footnotesize\bfseries, color=themefg] at (21.4, 0.50) {4B (CRC32)};
  \end{pgfonlayer}
\end{scope}

% ── L1 物理层 ──
\begin{scope}[yshift=0.0cm]
  \begin{pgfonlayer}{background}
    % 前导码与 SFD (深青/冷蓝)
    \fill[fill=themecurve!25!themebg, draw=themecurve, line width=1.1pt, rounded corners=4pt]
      (-12.0, 0) rectangle (-8.5, 1.45);
    % 完整物理帧信号 (继承珊瑚红语义底色)
    \fill[fill=themealert!10!themebg, draw=themealert!70, line width=1.1pt, rounded corners=4pt]
      (-8.5, 0) rectangle (22.8, 1.45);
  \end{pgfonlayer}
  \begin{pgfonlayer}{foreground}
    \node[font=\small\bfseries, color=themecurve] at (-10.25, 0.95) {前导码 / SFD};
    \node[font=\footnotesize\bfseries, color=themefg] at (-10.25, 0.50) {8B (物理时钟同步)};
    \node[font=\normalsize\bfseries, color=themealert] at (7.15, 0.95) {物理介质上传输的完整以太网帧比特流};
    \node[font=\footnotesize\bfseries, color=themefg] at (7.15, 0.45) {（以太网最小帧长 \textbf{64B} $\le L_{\text{frame}} \le$ 最大帧长 \textbf{1518B} / 带 802.1Q 标签 \textbf{1522B}）};
  \end{pgfonlayer}
\end{scope}

