  \begin{pgfonlayer}{foreground}
    \node[anchor=west, font=\large\bfseries, color=themecurve] at (-13.0, 0.55) {二、全协议栈分用指示链（Demultiplexing Tree：从底层帧向上层逐级分流）};

    % L2 链路层基座条文字
    \node[font=\normalsize\bfseries, color=themefg] at (4.9, -0.35) {数据链路层 (L2 Ethernet Frame) —— 收到帧校验 FCS 成功后，查 MAC 首部中的【\textbf{\color{themealert}Type 字段 (2B)}】向上分流};

    % L2 -> L3 分流判定点
    \node[font=\footnotesize\bfseries, color=themealert] at (-9.5, -1.18) {Type = 0x0806};
    \node[font=\footnotesize\bfseries, color=themecurve] at (8.25, -1.18) {Type = 0x0800};

    % L3 模块文字
    \node[font=\small\bfseries, color=themefg, align=center] at (-9.5, -2.12) {ARP 地址解析协议 (28B)\\\scriptsize \color{themefg} 直接由以太网帧承载 (无 IP 首部)};
    \node[font=\small\bfseries, color=themefg] at (8.25, -2.12) {IPv4 协议模块 —— 校验 Checksum，检查目的 IP 是否本机，TTL 减 1，查 IPv4 首部中的【\textbf{\color{themecurve}Protocol 字段 (8b)}】向上分流};

    % 连线 L2 -> L3
    \draw[themealert, line width=1.2pt, ->] (-9.5, -0.7) -- (-9.5, -1.0);
    \draw[themealert, line width=1.2pt, ->] (-9.5, -1.35) -- (-9.5, -1.65);
    \draw[themecurve, line width=1.2pt, ->] (8.25, -0.7) -- (8.25, -1.0);
    \draw[themecurve, line width=1.2pt, ->] (8.25, -1.35) -- (8.25, -1.65);

    % L3 -> L4 分流判定点
    \node[font=\scriptsize\bfseries, color=themecurve] at (-3.2, -3.02) {Protocol = 1};
    \node[font=\scriptsize\bfseries, color=themecurve] at (1.5, -3.02) {Protocol = 89};
    \node[font=\scriptsize\bfseries, color=themeamber] at (8.5, -3.02) {Protocol = 6};
    \node[font=\scriptsize\bfseries, color=themeamber] at (17.7, -3.02) {Protocol = 17};

    % L3/L4 协议文字
    \node[font=\small\bfseries, color=themefg, align=center] at (-3.2, -4.0) {ICMP 差错/探测\\\scriptsize \color{themefg} (属 L3 网络层，由 IP 封装)};
    \node[font=\small\bfseries, color=themefg, align=center] at (1.5, -4.0) {OSPF 路由协议\\\scriptsize \color{themefg} (网络层路由协议，由 IP 直承)};
    \node[font=\small\bfseries, color=themefg, align=center] at (8.5, -4.0) {TCP 传输控制协议\\\scriptsize \color{themefg} (面向连接 / 可靠字节流 / 流量与拥塞控制)};
    \node[font=\small\bfseries, color=themefg, align=center] at (17.7, -4.0) {UDP 用户数据报协议\\\scriptsize \color{themefg} (无连接 / 不可靠交互 / 尽最大努力交付)};

    % 连线 L3 -> L4
    \draw[themecurve, line width=1.1pt, ->] (-3.2, -2.6) -- (-3.2, -2.85);
    \draw[themecurve, line width=1.1pt, ->] (-3.2, -3.2) -- (-3.2, -3.5);

