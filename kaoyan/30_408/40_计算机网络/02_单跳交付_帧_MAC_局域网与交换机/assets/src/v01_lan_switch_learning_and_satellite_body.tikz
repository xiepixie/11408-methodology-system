  \draw[themegray!80, line width=1.0pt] (6.45, 1.5) -- (13.2, 1.5)
    node[midway, above, font=\scriptsize\bfseries, color=themeamber] {WAN: 128.14.32.158/30};

  % 卫星折线电磁波束
  \draw[themeamber, line width=1.2pt]
    (13.5, 2.1) -- ++(0.35, 0.7) -- ++(-0.25, 0.7) -- ++(0.4, 0.7) -- ++(-0.25, 0.7) -- ++(0.4, 0.7) -- (15.5, 5.25);
  \draw[themeamber, line width=1.2pt]
    (15.5, 5.25) -- ++(0.35, -0.7) -- ++(-0.25, -0.7) -- ++(0.4, -0.7) -- ++(-0.25, -0.7) -- ++(0.35, -0.7) -- (17.2, 2.1);
\end{pgfonlayer}

