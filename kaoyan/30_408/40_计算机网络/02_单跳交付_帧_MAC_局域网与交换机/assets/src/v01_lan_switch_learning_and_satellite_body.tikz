\begin{scope}[xshift=11.8cm, yshift=7.6cm]
  \begin{pgfonlayer}{background}
    \fill[fill=themefg!3!themebg, draw=themecurve!40, line width=0.7pt, rounded corners=6pt]
      (-0.3, -0.3) rectangle (6.5, 3.6);
    % 表头高亮底色
    \fill[fill=themecurve!18!themebg] (0, 1.95) rectangle (6.2, 2.5);
    % 表格外框与横线
    \draw[themegray!40, line width=0.5pt] (0, 0) rectangle (6.2, 2.5);
    \draw[themegray!40, line width=0.5pt] (0, 0.5) -- (6.2, 0.5);
    \draw[themegray!40, line width=0.5pt] (0, 1.0) -- (6.2, 1.0);
    \draw[themegray!40, line width=0.5pt] (0, 1.5) -- (6.2, 1.5);
    \draw[themegray!60, line width=0.8pt] (0, 1.95) -- (6.2, 1.95);
    % 竖线：第1列 (0 -> 2.8), 第2列 (2.8 -> 4.2), 第3列 (4.2 -> 6.2)
    \draw[themegray!40, line width=0.5pt] (2.8, 0) -- (2.8, 2.5);
    \draw[themegray!40, line width=0.5pt] (4.2, 0) -- (4.2, 2.5);
  \end{pgfonlayer}

  \begin{pgfonlayer}{foreground}
    \node[anchor=north] at (3.1, 3.35) {\bfseries\small\color{themecurve}交换表（自学习机制）};
    \node[font=\scriptsize\bfseries, color=themecurve] at (1.4, 2.22) {MAC 地址};
    \node[font=\scriptsize\bfseries, color=themecurve] at (3.5, 2.22) {端口号};
    \node[font=\scriptsize\bfseries, color=themecurve] at (5.2, 2.22) {有效期 (TTL)};

    \node[font=\scriptsize, color=themefg] at (1.4, 1.72) {22:11:11:11:11:AA};
    \node[font=\scriptsize\bfseries, color=themeamber] at (3.5, 1.72) {1};
    \node[font=\scriptsize, color=themegray] at (5.2, 1.72) {300s};

    \node[font=\scriptsize, color=themefg] at (1.4, 1.25) {22:11:11:11:11:DD};
    \node[font=\scriptsize\bfseries, color=themeamber] at (3.5, 1.25) {4};
    \node[font=\scriptsize, color=themegray] at (5.2, 1.25) {300s};

    \node[font=\scriptsize, color=themegray!50] at (3.1, 0.75) {$\cdots$};
    \node[font=\tiny, color=themegray!60] at (3.1, 0.25) {（收到帧自动登记源 MAC 与入端口）};
  \end{pgfonlayer}
\end{scope}

