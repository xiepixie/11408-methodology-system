% ══════════════════════════════════════════════════════════════
% ── 8. 底部考点总结卡片（无框通栏，宽裕呼吸感） ──
% ══════════════════════════════════════════════════════════════
\begin{scope}[xshift=-0.5cm, yshift=-3.4cm]
  \begin{pgfonlayer}{background}
    \fill[fill=themefg!4!themebg, draw=themegray!30, line width=0.6pt, rounded corners=4pt]
      (-0.3, -0.4) rectangle (19.4, 2.7);
  \end{pgfonlayer}
  \begin{pgfonlayer}{foreground}
    \node[anchor=north west, text width=19.0cm] at (0.0, 2.4) {
      \small \textbf{\color{themecurve}核心考点精要与机制辨析：}\\[0.4em]
      \scriptsize $\bullet$ \textbf{冲突域 vs 广播域}：集线器（物理层）所有端口共享 1 个冲突域；交换机（链路层）每个端口独占 1 个冲突域，整机为 1 个广播域；路由器（网络层）隔绝广播域。\\[0.3em]
      \scriptsize $\bullet$ \textbf{交换机自学习算法}：收到帧 $\to$ 记录【源 MAC $\to$ 入端口, TTL】；查目的 MAC：命中且端口不同则精准转发，同端口则丢弃过滤，未命中则全端口泛洪（Flooding）。\\[0.3em]
      \scriptsize $\bullet$ \textbf{异构链路与卫星信道}：以太网（全双工/CSMA/CD）、802.11 WLAN（CSMA/CA 碰撞避免）、卫星通信（地球同步轨道传播时延大 $\approx 270\text{ms}$，属单跳点对点链路）。
    };
  \end{pgfonlayer}
\end{scope}

\end{tikzpicture}
