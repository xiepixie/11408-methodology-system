\providecolor{themebg}{HTML}{FAFAF7}
\providecolor{themefg}{HTML}{111111}
\providecolor{themegray}{HTML}{666666}
\providecolor{themecurve}{HTML}{1D63B8}
\providecolor{themealert}{HTML}{C53030}
\providecolor{themeamber}{HTML}{B86E00}
\begin{tikzpicture}[font=\scriptsize,color=themefg,text=themefg,>=Stealth]
\tikzset{
  cell/.style={draw=themegray,minimum width=9.5mm,minimum height=7.2mm,inner sep=0pt,align=center},
  active/.style={cell,draw=themecurve,fill=themecurve!12!themebg},
  wait/.style={cell,draw=themealert,fill=themealert!14!themebg,font=\bfseries},
  bubble/.style={cell,draw=themeamber,dashed,text=themeamber},
  note/.style={rounded corners=3pt,draw=themegray!70,fill=themefg!3!themebg,inner xsep=7pt,inner ysep=6pt,align=left},
  flow/.style={->,line width=1.2pt,themecurve},
  bad/.style={->,line width=1.2pt,themealert}
}
\node[anchor=west,font=\bfseries\large] at (0,10.0) {经典五段流水线：冒险只在“需要时刻早于可用时刻”时变成停顿};
\node[anchor=west,text=themegray] at (0,9.45)
  {本图固定：IF--ID--EX--MEM--WB；ALU 结果 EX 末产生，Load 数据 MEM 末产生；支持 EX/MEM、MEM/WB $\to$ EX 旁路。};

% time header
\node[anchor=east,font=\bfseries] at (1.45,8.35) {时钟周期};
\foreach \c in {1,...,7}{\node[font=\bfseries,text=themegray] at (1.75+0.98*\c,8.35) {\c};}

% ── A. ALU forwarding panel (y = 7.6 .. 5.8) ──
\node[anchor=west,font=\bfseries,text=themecurve] at (0,7.6) {A. ALU $\to$ ALU：值在 EX 末已产生，旁路直接送达，无需等待 WB};
\node[anchor=east] at (1.45,6.85) {$I_1$: ADD};
\foreach \c/\s in {1/IF,2/ID,3/EX,4/MEM,5/WB}{\node[active] (a1\c) at (1.75+0.98*\c,6.85) {\s};}

\node[anchor=east] at (1.45,5.85) {$I_2$: SUB};
\foreach \c/\s in {2/IF,3/ID,4/EX,5/MEM,6/WB}{\node[active] (a2\c) at (1.75+0.98*\c,5.85) {\s};}

% 旁路连线 (从 a13 EX 底部指向 a24 EX 顶部)
\draw[flow] (a13.south) to[bend left=18] 
  node[midway,right=3pt,font=\tiny\bfseries,text=themecurve,fill=themebg,inner sep=1.5pt,rounded corners=1pt] {EX末产出 $\to$ 旁路} (a24.north);

\node[note,anchor=west,text width=6.2cm] at (9.8,6.35)
  {\textbf{Need--Ready 分析：}\\
   $I_1$ 的结果在\textbf{周期 3 末}（EX 阶段）已经算好；\\
   $I_2$ 直到\textbf{周期 4 初}（EX 阶段）才需要该操作数；\\
   因为 $\text{Ready} \le \text{Need}$，通过旁路直接连通，\textbf{0 停顿}。};

% ── B. Load-use panel (y = 5.0 .. 2.8) ──
\node[anchor=west,font=\bfseries,text=themealert] at (0,5.0) {B. Load-Use 冒险：数据在 MEM 末才产出，旁路无法“逆流时间”，必须停顿 1 拍};
\node[anchor=east] at (1.45,4.25) {$I_1$: LW};
\foreach \c/\s in {1/IF,2/ID,3/EX,4/MEM,5/WB}{\node[active] (l1\c) at (1.75+0.98*\c,4.25) {\s};}

\node[anchor=east] at (1.45,3.25) {$I_2$: ADD};
\node[active] (l22) at (1.75+0.98*2,3.25) {IF};
\node[wait] (l23) at (1.75+0.98*3,3.25) {ID};
\node[wait] (l24) at (1.75+0.98*4,3.25) {ID};
\node[active] (l25) at (1.75+0.98*5,3.25) {EX};
\node[active] at (1.75+0.98*6,3.25) {MEM};
\node[active] at (1.75+0.98*7,3.25) {WB};

% bubble 说明
\node[bubble,font=\tiny\bfseries] at (1.75+0.98*4,2.35) {Stall 1 拍};

% Load 旁路连线 (从 l14 MEM 底部指向 l25 EX 顶部)
\draw[bad] (l14.south) to[bend left=18] 
  node[midway,right=3pt,font=\tiny\bfseries,text=themealert,fill=themebg,inner sep=1.5pt,rounded corners=1pt] {MEM末产出 $\to$ 旁路} (l25.north);

\node[note,anchor=west,text width=6.2cm] at (9.8,3.5)
  {\textbf{时间错位分析：}\\
   $I_1$ 从内存读出的数据在\textbf{周期 4 末}才可用；\\
   $I_2$ 若周期 4 进 EX 则根本拿不到数据；\\
   必须硬件插入 1 拍 Stall（保持 ID），推迟到\textbf{周期 5 初}进入 EX 接收旁路。};

% ── C. Structural hazard panel (y = 1.6 .. 0.4) ──
\node[anchor=west,font=\bfseries,text=themeamber] at (0,1.6) {C. 结构冒险：多条指令同拍争抢同一物理部件（如单端口存储器）};
\node[cell,draw=themeamber,font=\scriptsize\bfseries] (mem) at (3.0,0.7) {$I_1$ MEM 阶段\\访问主存数据};
\node[cell,draw=themeamber,font=\scriptsize\bfseries] (fetch) at (6.5,0.7) {$I_4$ IF 阶段\\访问主存取指};
\node[font=\large\bfseries,text=themealert] at (4.75,0.7) {$\times$};

\node[note,anchor=west,text width=7.4cm] at (8.4,0.7)
  {只有当架构\textbf{共用单端口 Cache/主存}时才会冲突；\\
   若采用 Harvard 架构（指令 Cache 与数据 Cache 分离），此结构冒险彻底消失。};

\node[anchor=west,font=\scriptsize,text=themegray] at (0,-0.4)
  {禁止误读：Load-Use 停顿拍数取决于微架构；若增加 MEM 访问周期或采用乱序发射，必须重新比对 Ready 与 Need 时刻。};
\end{tikzpicture}
