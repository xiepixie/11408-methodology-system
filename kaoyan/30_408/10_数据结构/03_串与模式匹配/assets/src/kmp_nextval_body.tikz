\providecolor{themebg}{HTML}{FAFAF7}
\providecolor{themefg}{HTML}{111111}
\providecolor{themegray}{HTML}{666666}
\providecolor{themecurve}{HTML}{1D63B8}
\providecolor{themealert}{HTML}{C53030}
\providecolor{themeamber}{HTML}{B86E00}
\providecolor{themegreen}{HTML}{15803D}
\begin{tikzpicture}[>=Stealth,font=\small,color=themefg,text=themefg]
\tikzset{
  state/.style={rounded corners=3pt,draw=themegray,fill=themefg!3!themebg,minimum width=2.5cm,minimum height=1.05cm,align=center},
  redundant/.style={state,draw=themealert,fill=themealert!12!themebg},
  keep/.style={state,draw=themecurve,fill=themecurve!12!themebg},
  jump/.style={->,line width=1.1pt,themegray},
  skip/.style={->,line width=1.4pt,themeamber,dashed},
  card/.style={rounded corners=4pt,draw=themegray!70,fill=themefg!3!themebg,inner xsep=9pt,inner ysep=7pt,align=left}
}

% ── 标题与场景说明 ──
\node[anchor=west,font=\bfseries\large] at (0,7.9) {\texttt{nextval} 递归去重：把“字符相同、已知必败”的冗余回退提前跳过};
\node[anchor=west,text=themegray] at (0,7.35)
  {场景：模式串 $P=\texttt{aabaaab}$。考查 $j=4$：此时 $P[4]=\texttt{a}$，常规 $next[4]=1$，而 $P[1]=\texttt{a}$。};

% ── 1. 上半部分：为什么字符相同时该状态必败？ (y = 5.7) ──
\node[state] (s4) at (2.0,5.7) {$j=4$\\比对 $P[4]=\texttt{a}$};
\node[redundant] (s1) at (6.8,5.7) {$j=1$\quad{\color{themealert}\textbf{[冗余]}}\\再次比对 $P[1]=\texttt{a}$};
\node[keep] (sm1) at (11.6,5.7) {$j=-1$\\哨兵状态};

% 原始 next 回退链
\draw[jump] (s4) -- node[above=2pt,font=\scriptsize] {$next[4]=1$} (s1);
\draw[jump] (s1) -- node[above=2pt,font=\scriptsize] {$nextval[1]=-1$} (sm1);

% 冗余失配说明 (双行居中，彻底消除左右边界干涉)
\node[font=\scriptsize\bfseries,text=themealert,align=center,fill=themebg,inner sep=2.5pt,rounded corners=2pt] at (6.8,4.45)
  {若主串字符 $T[i]\neq\texttt{a}$ 导致 $j=4$ 失配，\\回退到 $P[1]=\texttt{a}$ 必定再次失配！};

% nextval 单跳直达箭头
\draw[skip] (s4.south) to[bend right=38] 
  node[midway,below=3pt,font=\scriptsize\bfseries,text=themeamber,fill=themebg,inner sep=2pt,rounded corners=1pt]
  {$nextval[4] = nextval[1] = -1$（递归跳过已知必败状态）} (sm1.south);

% ── 2. 下半部分：对照——什么时候必须保留状态？ ──
\draw[themegray!40,line width=0.6pt] (0,2.3) -- (16.5,2.3);
\node[anchor=west,font=\bfseries,text=themecurve] at (0,1.75) {对照组：字符不同时为什么不能跳？};

\node[state] (s5) at (2.0,0.7) {$j=5$\\$P[5]=\texttt{a}$};
\node[keep] (s2) at (6.8,0.7) {$next[5]=2$\\$P[2]=\texttt{b}$};
\draw[->,line width=1.2pt,themecurve] (s5) -- node[above=2pt,font=\scriptsize\bfseries,text=themecurve] {$P[5]\neq P[2]\;(\texttt{a}\neq\texttt{b})$} (s2);

\node[card,anchor=west,text width=7.6cm] at (8.5,0.7)
  {当前字符 $T[i]\neq\texttt{a}$ 虽导致 $j=5$ 失配，但 $T[i]$ 完全可能等于 \texttt{b}！\\
   因此 $next[5]=2$ 属于有效候选分支，\textbf{必须保留}：$nextval[5]=2$。};

% ── 3. 底部结论条 ──
\node[anchor=west,font=\bfseries,text=themecurve] at (0,-0.7)
  {$\boxed{P[j] == P[next[j]] \implies \text{当前 } T[i] \text{ 处回退必定再次失配，令 } nextval[j] = nextval[next[j]]}$};
\end{tikzpicture}
