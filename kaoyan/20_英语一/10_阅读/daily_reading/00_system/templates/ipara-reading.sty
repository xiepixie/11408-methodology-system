\newenvironment{takeawaylist}{%
  \begin{enumerate}[label=\textbf{\color{readGreen}\arabic*.},leftmargin=1.5em,itemsep=0.25em,topsep=0.18em]
    \small
}{%
  \end{enumerate}
}

