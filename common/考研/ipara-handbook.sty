% -----------------------------------------------------
% Tables
% -----------------------------------------------------
\newcolumntype{Y}{>{\RaggedRight\arraybackslash}X}
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\Centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\RaggedLeft\arraybackslash}p{#1}}
\renewcommand{\arraystretch}{1.22}
\setlength{\tabcolsep}{4pt}
\setlength{\extrarowheight}{1pt}

% Direct tabularx should never accidentally continue an existing paragraph.
% tabularx must see its complete body while measuring X columns, so these wrappers
% capture the body first instead of splitting \begin{tabularx}/\end{tabularx} across
% an outer environment boundary.
\NewDocumentEnvironment{handbooktable}{m +b}{%
  \par\addvspace{0.45em}%
  \begingroup\small
  \renewcommand{\arraystretch}{1.22}%
  \setlength{\tabcolsep}{4pt}%
  \noindent\begin{tabularx}{\linewidth}{@{}#1@{}}%
    #2%
  \end{tabularx}%
  \par\endgroup\addvspace{0.45em}%
}{}

% Forward-compatible multi-page table shim. New Family code owns the long-term
% implementation; the prototype exposes the same author API so actively edited
% Canonical handbooks can migrate layout without maintaining two source forms.
\NewDocumentEnvironment{handbooklongtable}{m +b}{%
  \par\addvspace{0.45em}%
  \begingroup\small
  \renewcommand{\arraystretch}{1.22}%
  \setlength{\tabcolsep}{4pt}%
  \setlength{\extrarowheight}{1pt}%
  \begin{xltabular}{\linewidth}{@{}#1@{}}%
    #2%
  \end{xltabular}%
  \par\endgroup\addvspace{0.45em}%
}{}

% Standard 5-column concept-boundary table from handbook_writing_spec.md.
\NewDocumentEnvironment{boundarytable}{+b}{%
  \par\addvspace{0.45em}%
  \begingroup\small
  \renewcommand{\arraystretch}{1.22}%
  \setlength{\tabcolsep}{4pt}%
  \noindent\begin{tabularx}{\linewidth}{@{}L{0.16\linewidth} C{0.035\linewidth} L{0.16\linewidth} Y Y@{}}%
    #1%
  \end{tabularx}%
  \par\endgroup\addvspace{0.45em}%
}{}

\newcommand{\boundarytablehead}{%
  \toprule
  \textbf{概念 A} & \textbf{≠} & \textbf{概念 B} & \textbf{真正区别与题目信号} & \textbf{混淆后果}\\
  \midrule
}

