% -----------------------------------------------------
% Design tokens
% -----------------------------------------------------
\definecolor{iparaDeep}{RGB}{42,58,73}
\definecolor{iparaSoft}{RGB}{245,247,249}
\definecolor{iparaAccent}{RGB}{104,76,55}
\definecolor{iparaGreen}{RGB}{57,92,76}
\definecolor{iparaWarn}{RGB}{136,68,63}
\definecolor{iparaPurple}{RGB}{87,72,116}
\definecolor{iparaRule}{RGB}{145,154,163}
\definecolor{iparaCodeBg}{RGB}{247,248,249}

\setlength{\emergencystretch}{2.5em}
\setlist[itemize]{itemsep=0.18em,topsep=0.35em,leftmargin=2em}
\setlist[enumerate]{itemsep=0.18em,topsep=0.35em,leftmargin=2em}

% -----------------------------------------------------
% Shared table primitives
% -----------------------------------------------------
\newcolumntype{Y}{>{\RaggedRight\arraybackslash}X}
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\Centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\RaggedLeft\arraybackslash}p{#1}}

\NewDocumentEnvironment{iparatable}{m +b}{%
  \par\addvspace{0.45em}%
  \begingroup\small
  \renewcommand{\arraystretch}{1.22}%
  \setlength{\tabcolsep}{4pt}%
  \setlength{\extrarowheight}{1pt}%
  \noindent\begin{tabularx}{\linewidth}{@{}#1@{}}%
    #2%
  \end{tabularx}%
  \par\endgroup\addvspace{0.45em}%
}{}

% -----------------------------------------------------
% Semantic renderer registry
% The public names describe meaning; these styles are renderer defaults.
% A Family/Profile may redefine the ipara semantic <type> style later.
% -----------------------------------------------------
\tcbset{
  ipara semantic base/.style={
    enhanced,
    breakable,
    boxrule=0.7pt,
    arc=1.5mm,
    left=1.8mm,right=1.8mm,top=1.2mm,bottom=1.2mm,
    before skip=0.6em,
    after skip=0.6em,
    fonttitle=\bfseries
  },
  ipara semantic mentalmodel/.style={colback=iparaSoft,colframe=iparaDeep},
  ipara semantic mechanism/.style={colback=white,colframe=iparaGreen},
  ipara semantic criterion/.style={colback=white,colframe=iparaPurple},
  ipara semantic boundary/.style={colback=white,colframe=iparaAccent},
  ipara semantic example/.style={colback=white,colframe=iparaRule},
  ipara semantic warning/.style={colback=white,colframe=iparaWarn}
}

\NewTColorBox{mentalmodel}{m}{ipara semantic base,ipara semantic mentalmodel,title={#1}}
\NewTColorBox{mechanism}{m}{ipara semantic base,ipara semantic mechanism,title={#1}}
\NewTColorBox{criterion}{m}{ipara semantic base,ipara semantic criterion,title={#1}}
\NewTColorBox{boundary}{m}{ipara semantic base,ipara semantic boundary,title={#1}}
\NewTColorBox{example}{m}{ipara semantic base,ipara semantic example,title={#1}}
\NewTColorBox{warning}{m}{ipara semantic base,ipara semantic warning,title={#1}}

\newcommand{\kw}[1]{\textbf{\color{iparaDeep}#1}}
\newcommand{\code}[1]{\texttt{#1}}
\newcommand{\codepath}[1]{\nolinkurl{#1}}
\urlstyle{tt}

% -----------------------------------------------------
% Code Highlighting & Continuous Numbering
% -----------------------------------------------------
\definecolor{iparaCodeKw}{RGB}{20,60,140}       % Keywords: Deep Navy Blue
\definecolor{iparaCodeComment}{RGB}{110,115,125}% Comments: Muted Slate Gray
\definecolor{iparaCodeString}{RGB}{160,50,40}   % Strings: Terracotta Red
\definecolor{iparaCodeType}{RGB}{85,45,120}     % Types / Identifiers: Purple
\definecolor{iparaCodeNum}{RGB}{135,140,148}    % Line Numbers: Subtle Gray
\definecolor{iparaCodeDirect}{RGB}{130,40,90}   % Preprocessor / Directives: Plum

\lstdefinestyle{ipara}{
  basicstyle=\ttfamily\footnotesize,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=false,
  tabsize=2,
  frame=single,
  rulecolor=\color{iparaRule},
  backgroundcolor=\color{iparaCodeBg},
  framesep=5pt,
  numbers=left,
  firstnumber=1,
  numberstyle=\tiny\ttfamily\color{iparaCodeNum},
  numbersep=7pt,
  xleftmargin=16pt,
  framexleftmargin=16pt,
  keywordstyle=\color{iparaCodeKw}\bfseries,
  keywordstyle=[2]\color{iparaCodeType}\bfseries,
  commentstyle=\color{iparaCodeComment}\itshape,
  stringstyle=\color{iparaCodeString},
  emphstyle=\color{iparaCodeType}\bfseries,
  keywords=[2]{
    size_t, uint8_t, uint16_t, uint32_t, uint64_t, int8_t, int16_t, int32_t, int64_t,
    nullptr, constexpr, noexcept, override, final, auto, string, vector, unique_ptr,
    shared_ptr, optional, nullopt, pair, make_unique, make_shared, make_pair,
    tuple, get, max, min, swap, move, forward
  },
  aboveskip=0.6em,
  belowskip=0.6em,
  captionpos=b
}
\lstset{style=ipara}
\renewcommand{\lstlistingname}{代码清单}

% -----------------------------------------------------
% Base TikZ vocabulary
% -----------------------------------------------------
\tikzset{
  every picture/.style={line cap=round,line join=round},
  ipara node/.style={
    draw=iparaDeep,
    fill=iparaSoft,
    rounded corners=1.3mm,
    minimum height=8mm,
    align=center,
    inner xsep=5pt,
    inner ysep=3.5pt,
    font=\small
  },
  ipara state/.style={ipara node,fill=white,double,double distance=1pt},
  ipara process/.style={ipara node,fill=white},
  ipara decision/.style={ipara node,diamond,aspect=2,inner xsep=3pt},
  ipara edge/.style={-{Latex[length=2mm,width=1.4mm]},draw=iparaDeep,line width=0.7pt},
  ipara ref/.style={-{Latex[length=2mm,width=1.4mm]},draw=iparaRule,dashed,line width=0.6pt},
  ipara emphasis/.style={-{Latex[length=2mm,width=1.4mm]},draw=iparaPurple,line width=0.8pt},
  ipara label/.style={font=\scriptsize,fill=white,inner sep=1.2pt,text=black}
}

% Display-math rhythm shared unless a Family explicitly overrides it.
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{7pt plus 2pt minus 2pt}%
  \setlength{\belowdisplayskip}{7pt plus 2pt minus 2pt}%
  \setlength{\abovedisplayshortskip}{4pt plus 1pt minus 1pt}%
  \setlength{\belowdisplayshortskip}{4pt plus 1pt minus 1pt}%
}

\endinput
