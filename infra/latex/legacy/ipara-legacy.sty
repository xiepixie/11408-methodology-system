  \noindent\textbf{【检查点】} #1\par
  {\small
  \textbf{通过：}#2\par
  \textbf{未通过：}#3\par}
}

% 现场观察留白。可在打印稿上手写
\newcommand{\liveobserve}[1][3.5cm]{%
