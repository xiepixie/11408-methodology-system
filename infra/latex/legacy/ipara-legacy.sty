  \noindent\textbf{【课堂观察记录】}\par
  \vspace{0.2em}%
  \begin{tcolorbox}[
    enhanced,
    colback=white,
    colframe=rulecolor,
    boxrule=0.5pt,
    arc=0pt,
    height=#1,
