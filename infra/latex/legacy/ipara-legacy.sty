% 专题讲义与教学诊断组件
% =====================================================

% 1. 课前唤醒/思路脚手架（学生端优先）
\newcommand{\prehint}[1]{%
  \vspace{0.4em}
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=white,
    colframe=rulecolor,
    boxrule=0pt,
    leftrule=2pt,
    arc=0pt,
    left=8pt, right=8pt, top=4pt, bottom=4pt
  ]
    {\small\color{black!75}\textbf{【思路唤醒】}\par\vspace{0.2em}#1}
  \end{tcolorbox}
  \vspace{0.4em}
}

% 2. 同结构变式训练头
\newcommand{\variantproblem}[1]{%
  \vspace{1.2em}
  \noindent{\large\textbf{◆ 变式训练\quad #1}}
  \par\vspace{0.6em}
}

% 3. 教学价值判断（教师端）
\newcommand{\teachvalue}[1]{%
  \vspace{0.2em}
  \begin{tcolorbox}[
    enhanced,
    colback=gray!6,
    colframe=white,
    boxrule=0pt,
    arc=2pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt
  ]
    {\small\textbf{【本题价值】} #1}
  \end{tcolorbox}
  \vspace{0.4em}
}

% 4. 课后补救建议（教师端）
\newcommand{\remedy}[1]{%
  \par\addvspace{0.8em}%
  \noindent\textbf{【补救建议】}\par
  \begingroup
    \raggedright
    \setlength{\parskip}{0.35em}%
    #1\par
  \endgroup
}

% =====================================================
% 教师课堂可用性与教学导引组件 (Teacher Usability v2)
