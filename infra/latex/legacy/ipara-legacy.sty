  ]
  \end{tcolorbox}
}

% 课后画像候选：强调“候选”，避免单次表现直接标签化
\newcommand{\profilecandidate}[1]{%
  \par\addvspace{0.5em}%
  \noindent\textbf{【画像候选（课后确认）】}\par
  {\small #1}\par
}

% 一页路线表建议列：顺序、题目、处理、时间、检查点、分支
\newcommand{\teacherroutehint}{%
  {\small\textbf{课堂使用：}先看检查点，再决定继续、降阶或跳过；不要因为教案准备了完整解法就机械讲完。}%
}

