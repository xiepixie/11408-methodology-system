    enhanced,
    colback=gray!4,
    colframe=black!55,
    boxrule=0.5pt,
    arc=0pt,
    left=7pt,right=7pt,top=5pt,bottom=5pt
  ]
  {\small
  \textbf{处理：}#1\quad
  \textbf{预算：}#2\par
  \textbf{本题目标：}#3\par
  \textbf{停止条件：}#4}
  \end{tcolorbox}
}

% 课堂检查点：让教师快速决定继续/降阶/跳过
